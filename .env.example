# ==============================================================================
# LLM Provider Chain (Open-Weight Models First)
# Add or swap open-weight providers by changing these variables. The pipeline
# tries each provider in order (1 -> 2 -> 3) on quota exhaustion or circuit break.
# A missing key means that provider is skipped silently.
# ==============================================================================

# Provider 1 (Primary) - Google Gemma 2 (Local via Ollama or Cloud Open-Weight)
# Runs 100% locally on your machine: zero data leakage, zero API bills, 100% private!
# Quick start: run `ollama run gemma2:9b` in another terminal.
LLM_PROVIDER_1_NAME=gemma2-local
LLM_PROVIDER_1_API_KEY=ollama
LLM_PROVIDER_1_BASE_URL=http://localhost:11434/v1
LLM_PROVIDER_1_MODEL=gemma2:9b
LLM_PROVIDER_1_RPM=120
LLM_PROVIDER_1_TPM=1000000
LLM_PROVIDER_1_CONCURRENCY=2

# Provider 2 (Fallback 1) - Google Gemma 2 Cloud (Groq / OpenRouter / Hugging Face)
# High-speed hosted open weights fallback (e.g. Groq free tier with gemma2-9b-it)
LLM_PROVIDER_2_NAME=gemma2-cloud
LLM_PROVIDER_2_API_KEY=your_open_weight_api_key_here
LLM_PROVIDER_2_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER_2_MODEL=gemma2-9b-it
LLM_PROVIDER_2_RPM=30
LLM_PROVIDER_2_TPM=500000
LLM_PROVIDER_2_CONCURRENCY=1

# Provider 3 (Fallback 2) - Open-Weight Llama / Mistral (Local or Cloud)
LLM_PROVIDER_3_NAME=llama-open-weight
LLM_PROVIDER_3_API_KEY=your_open_weight_api_key_here
LLM_PROVIDER_3_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER_3_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER_3_RPM=30
LLM_PROVIDER_3_TPM=200000
LLM_PROVIDER_3_CONCURRENCY=1

# LLM behaviour settings (apply to all providers)
# LLM_DEV_CACHE=true stores responses in .cache/llm/ keyed by prompt hash.
# Use during debugging to avoid re-generating. NEVER set in production.
LLM_DEV_CACHE=false

# ==============================================================================
# Crawler & Security Settings
# ==============================================================================

# Allow fetching localhost and private IP ranges. Set to true only inside the
# CLI process (evaluate.ts sets it automatically). Never set in production.
ALLOW_PRIVATE_HOSTS=false

# Maximum pages the crawler fetches per company site.
CRAWL_MAX_PAGES=10

# ==============================================================================
# Database & Server (packages/server)
# ==============================================================================

# MongoDB Atlas or local MongoDB instance (prepme database)
MONGODB_URI=mongodb://localhost:27017/prepme
SESSION_SECRET=development_session_secret_change_in_production
CLIENT_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# ==============================================================================
# Frontend (packages/web)
# ==============================================================================

# Backend URL used by the browser when not using the Next.js proxy.
# In production, leave this empty and use Next.js rewrites to proxy /api/*.
NEXT_PUBLIC_API_URL=http://localhost:4000
